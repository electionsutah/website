{
  "name": "elections-utah-modern",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^18.0.0 || ^20.0.0 || >=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prerender-routes.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "refresh:results": "python3 scripts/refresh-election-results.py && uv run --with xlrd python scripts/import-all-results.py --use-cache",
    "refresh:history": "python3 scripts/import-result-history.py",
    "check:shifts": "node scripts/check-shifts.mjs",
    "refresh:boundaries": "python3 scripts/import-legislative-boundaries.py",
    "check:map": "node scripts/check-legislative-map.mjs",
    "mcp": "node scripts/mcp-dev.mjs",
    "editor": "node editor/dev.mjs",
    "editor:prepare": "node editor/prepare.mjs",
    "check:editor": "node editor/check.mjs",
    "editor:install": "npm --prefix editor ci",
    "check:profiles": "node scripts/check-entity-profiles.mjs",
    "check:researched": "node scripts/check-researched-candidates.mjs",
    "audit:coverage": "node scripts/audit-municipal-coverage.mjs",
    "check:links": "node scripts/check-entity-links.mjs && node scripts/check-office-links.mjs && node scripts/check-party-links.mjs && node scripts/check-person-links.mjs && node scripts/check-place-links.mjs",
    "refresh:municipal-results": "python3 scripts/import-municipal-results.py",
    "check:municipal-results": "node scripts/check-municipal-results.mjs",
    "refresh:newspaper": "python3 scripts/import-newspaper-elections.py --import && python3 scripts/import-municipal-results.py && node scripts/report-newspaper-elections.mjs",
    "refresh:all-results": "uv run --with xlrd python scripts/import-all-results.py",
    "check:results": "python3 -m unittest discover -s scripts -p test_result_contract.py && node scripts/check-filing-results.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "5.56.8",
    "svelte-check": "4.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2",
    "vite": "6.4.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "maplibre-gl": "^6.16.0",
    "zod": "^4.6.7"
  }
}
